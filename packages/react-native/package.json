{
  "name": "@veryo/react-native",
  "version": "0.1.0",
  "description": "Collects device signals for VERYO antifraud in Expo / React Native apps. No network calls, no API key.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external react-native --external expo-device --external expo-application --external expo-secure-store",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "expo-application": "*",
    "expo-device": "*",
    "expo-secure-store": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "expo-application": "~58.1.2",
    "expo-device": "~58.0.5",
    "expo-secure-store": "~58.0.2",
    "react-native": "0.88.1"
  }
}
