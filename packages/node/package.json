{
  "name": "@veryo/node",
  "version": "0.1.0",
  "description": "VERYO server SDK for Node.js and Bun: send and check OTP verifications, verify webhooks",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --target node18",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^18.19.0"
  }
}
